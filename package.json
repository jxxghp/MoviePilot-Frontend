    "@fullcalendar/vue3": "^6.1.15",
    "@iconify/utils": "^2.1.33",
    "@vueuse/core": "^11.2.0",
    "@vueuse/math": "^11.2.0",
    "ace-builds": "^1.36.3",
    "apexcharts-clevision": "^3.28.5",
    "axios": "1.7.7",
    "colorthief": "^2.6.0",
    "dayjs": "^1.11.13",
