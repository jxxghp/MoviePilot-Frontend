{
  "name": "moviepilot",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "bin": "dist/service.js",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . -c .eslintrc.mjs --fix --ext .ts,.js,.vue,.tsx,.jsx,.mjs",
    "build:icons": "tsc -b src/@iconify && node src/@iconify/build-icons.mjs",
    "postinstall": "npm run build:icons",
    "pkg": "pkg . -t node18-win-x64 -o MoviePilot-Frontend.exe"
  },
  "pkg": {
    "assets": [
      "dist/**/*"
    ]
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
